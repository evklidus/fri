# Caddy reverse-proxy for FRI.
#
# Topology (post-2026-05-16, after RU users started getting throttled
# when CF Tunnel was in the path):
#
#   Visitor ──HTTPS──► 72.56.240.17 ──► Caddy ──► Go app :8080
#                     (server's IPv4)
#
# Why we dropped Cloudflare proxy:
#   Russian ISPs (TSPU equipment) throttle HTTPS handshakes to many
#   Cloudflare edge IPs since 2022. The demo's primary user is in RU,
#   so an unreliable path to CF blocks the whole investor pitch.
#
# Trade-offs vs the old CF Tunnel setup:
#   - We manage our own TLS cert (Let's Encrypt via Caddy ACME).
#   - We expose the origin IP publicly (no CF DDoS shield).
#   - We need port 443 open (compose + ufw).
#
# Cloudflare DNS still serves the A record but with "DNS only" (gray
# cloud) — no proxy, no Tunnel involvement.

{
	# Email for Let's Encrypt cert renewal alerts. Set in .env on the
	# server; falls back to a sane default if unset.
	email {$ACME_EMAIL:admin@footballreputationindex.online}
}

# Primary site — both apex and www get the same cert + same proxy rule.
# Caddy automatically: gets LE cert, redirects :80 → :443, renews.
footballreputationindex.online, www.footballreputationindex.online {
	reverse_proxy app:8080

	# Cheap security headers.
	header {
		# Don't allow MIME sniffing.
		X-Content-Type-Options "nosniff"
		# Block clickjacking via iframe.
		X-Frame-Options "DENY"
		# Don't leak referer when users click out to news article links.
		Referrer-Policy "strict-origin-when-cross-origin"
		# Hide default `Server: Caddy` banner.
		-Server
	}

	# Compress text responses.
	encode zstd gzip

	# Access log to stdout — captured by docker logs.
	log {
		output stdout
		format console
		level INFO
	}
}

# Catch-all on :80 for any other host (raw IP access, the old .ru
# domain still in the wild, etc.). Caddy responds 200 + the app's
# content so the site is still reachable by IP for debugging. No
# ACME triggered here because there's no hostname.
:80 {
	reverse_proxy app:8080
}
