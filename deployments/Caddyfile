# Caddy reverse-proxy for FRI.
#
# Topology (post-2026-05-16, after RU users started getting throttled
# when CF Tunnel was in the path):
#
#   Visitor ──HTTPS──► 72.56.240.17 ──► Caddy ──► Go app :8080
#                     (server's IPv4)
#
# Why we dropped Cloudflare proxy:
#   Russian ISPs (TSPU equipment) throttle HTTPS handshakes to many
#   Cloudflare edge IPs since 2022. The demo's primary user is in RU,
#   so an unreliable path to CF blocks the whole investor pitch.
#
# Trade-offs vs the old CF Tunnel setup:
#   - We manage our own TLS cert (Let's Encrypt via Caddy ACME).
#   - We expose the origin IP publicly (no CF DDoS shield).
#   - We need port 443 open (compose + ufw).
#
# Cloudflare DNS still serves the A record but with "DNS only" (gray
# cloud) — no proxy, no Tunnel involvement.

{
	# Email for Let's Encrypt cert renewal alerts. Hardcoded because
	# Caddy's {$VAR:default} env substitution doesn't fall back when the
	# variable is explicitly empty (which is what docker-compose passes
	# when .env doesn't define ACME_EMAIL) — Caddy reads "" as a value and
	# fails with "wrong argument count after email". Just hardcoding the
	# default avoids the trap.
	email admin@footballreputationindex.online

	# Pin the ACME CA to Let's Encrypt. By default Caddy falls back to
	# ZeroSSL when LE fails, but from this Moscow host ZeroSSL's account
	# API answers with something that isn't JSON — Caddy dies on
	# "invalid character 'A' looking for beginning of value", most likely
	# a geo-block page. That turns a real LE failure into a confusing
	# ZeroSSL error and buries the actual cause. LE alone is predictable.
	acme_ca https://acme-v02.api.letsencrypt.org/directory
}

# Primary site — both apex and www get the same cert + same proxy rule.
# Caddy automatically: gets LE cert, redirects :80 → :443, renews.
footballreputationindex.online, www.footballreputationindex.online {
	reverse_proxy app:8080

	# Cheap security headers.
	header {
		# Don't allow MIME sniffing.
		X-Content-Type-Options "nosniff"
		# Block clickjacking via iframe.
		X-Frame-Options "DENY"
		# Don't leak referer when users click out to news article links.
		Referrer-Policy "strict-origin-when-cross-origin"
		# Hide default `Server: Caddy` banner.
		-Server
	}

	# Compress text responses.
	encode zstd gzip

	# Cache policy. The Go static server sends only Last-Modified and no
	# Cache-Control at all, which leaves browsers free to reuse a page
	# heuristically without asking. That is fine for a picture and bad for
	# this one: index.html carries the i18n dictionary, the History-API
	# router and the data loaders inline, so a visitor holding a broken copy
	# keeps holding it. When an apostrophe in the About copy killed that
	# script on 2026-09-03, the deployed fix still would not have reached
	# anyone whose browser had already stored the broken page.
	#
	# `no-cache` still stores the response — it just has to revalidate
	# before reuse, and Last-Modified turns almost every check into a cheap
	# 304. Assets are unhashed (live.js, logo.png), so they get a few
	# minutes of reuse and then revalidate too.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=300, must-revalidate"
	header /api/* Cache-Control "no-store"
	header {
		Cache-Control "no-cache"
	}

	# Access log to stdout — captured by docker logs.
	log {
		output stdout
		format console
		level INFO
	}
}

# Catch-all on :80 for any other host (raw IP access, the old .ru
# domain still in the wild, etc.). Caddy responds 200 + the app's
# content so the site is still reachable by IP for debugging. No
# ACME triggered here because there's no hostname.
:80 {
	reverse_proxy app:8080
}
